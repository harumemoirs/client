# API URL pointing to the backend Cloudflare Worker
# Local development: http://localhost:8787
# Production: https://api.harumemoirs.in
NEXT_PUBLIC_API_URL=https://api.harumemoirs.in

# Resend API Key for sending contact form emails (from resend.com)
RESEND_API_KEY=re_your_api_key_here

# MongoDB Connection URI for storing contact form submissions (from cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
