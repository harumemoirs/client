# API URL pointing to the backend Cloudflare Worker
# Local development: http://localhost:8787
# Production: https://api.harumemoirs.in
API_URL=https://api.harumemoirs.in

# Resend API Key for sending contact form emails (from https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Neon PostgreSQL connection string for contact submissions & rate limiting (from https://console.neon.tech)
DATABASE_URL=postgresql://<user>:<password>@<ep-endpoint>.neon.tech/<dbname>?sslmode=require
